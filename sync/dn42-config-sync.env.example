# dn42-config-sync 节点配置（安装到 /etc/dn42-config-sync.env）

# 节点名 = 仓库里的目录名（hkt / fra / lax / tyo），默认取 hostname -s
NODE_NAME=hkt

# 私有备份仓库（必须私有：同步内容含 WG 私钥明文）
REPO_URL=git@github.com:AndyYJF/dn42-config.git
BRANCH=main

# 工作目录与配置来源（一般不用改）
WORK_DIR=/var/lib/dn42-config-sync
WG_DIR=/etc/wireguard
BIRD_DIR=/etc/bird

# 专用 deploy key（部署时生成并用 gh 加到仓库 deploy keys）；source 语法，含空格必须加引号
GIT_SSH_COMMAND="ssh -i /root/.ssh/dn42-config-sync -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
